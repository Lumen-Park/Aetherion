# Copy to .env on the deployment host. Never commit actual secrets.
AETHERION_DOMAIN=
AETHERION_API_KEYS=
AETHERION_JWT_SECRET=
AETHERION_CHAT_MODEL=
OLLAMA_BASE_URL=
# Optional comma-separated HTTPS domains for bounded Deep Research URL retrieval.
# Leave blank to disable live URL retrieval.
AETHERION_RESEARCH_ALLOWLIST=
AETHERION_IDENTITY_DEFAULT_ROLE=operator
AETHERION_SUPABASE_URL=
AETHERION_SUPABASE_PUBLISHABLE_KEY=
# Optional local MMDB country lookup, mounted from ./geoip. See DESIGN_EXPERIENCE.md.
AETHERION_GEOIP_DATABASE=
# Only the actual reverse proxy addresses/subnets; never a catch-all CIDR.
AETHERION_TRUSTED_PROXY_CIDRS=
